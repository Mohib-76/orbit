<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Orbit</RootNamespace>
    <AssemblyName>Orbit</AssemblyName>
    <ApplicationIcon>Assets\orbit.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon; keep its names out of the global namespace. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\orbit.ico" />
  </ItemGroup>

  <!-- Ship adb next to Orbit.exe so USB features work without the Android SDK installed.
       tools/fetch-thirdparty.ps1 puts it in ThirdParty/platform-tools (from the scrcpy release). -->
  <PropertyGroup>
    <AdbSourceDir>$(MSBuildThisFileDirectory)ThirdParty\platform-tools</AdbSourceDir>
    <AdbSourceDir Condition="!Exists('$(AdbSourceDir)\adb.exe')">$(LOCALAPPDATA)\Android\Sdk\platform-tools</AdbSourceDir>
  </PropertyGroup>
  <Target Name="WarnMissingThirdParty" BeforeTargets="Build" Condition="!Exists('$(MSBuildThisFileDirectory)ThirdParty\scrcpy\scrcpy-server')">
    <Warning Text="Third-party files missing: run tools\fetch-thirdparty.ps1 (screen mirroring will not work without them)." />
  </Target>

  <!-- License texts shown in the About window. -->
  <ItemGroup>
    <None Include="..\..\LICENSE;..\..\THIRD_PARTY_NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(AdbSourceDir)\adb.exe')">
    <None Include="$(AdbSourceDir)\adb.exe;$(AdbSourceDir)\AdbWinApi.dll;$(AdbSourceDir)\AdbWinUsbApi.dll"
          Link="adb\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Screen mirroring: scrcpy's device server and FFmpeg decoder DLLs (see ThirdParty/scrcpy/README.md). -->
  <ItemGroup>
    <None Include="ThirdParty\scrcpy\scrcpy-server;ThirdParty\scrcpy\*.dll;ThirdParty\scrcpy\LICENSE.txt"
          Link="scrcpy\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
