<Window x:Class="Orbit.UI.UsbConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Orbit.UI"
        Title="Turn off USB tethering?" Width="476" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Manrope}" Foreground="{DynamicResource Text}">
    <Border Margin="8" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Margin="28,28,28,22">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AmberSoft}" Margin="0,0,12,0">
                        <ui:Ic Data="{StaticResource IcWifi}" Width="20" Height="20" Foreground="{DynamicResource AmberInk}"/>
                    </Border>
                    <TextBlock Text="Turn off USB tethering?" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="Body" FontSize="14" LineHeight="21" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                    <DockPanel>
                        <ui:Ic Data="{StaticResource IcInfo}" Width="16" Height="16" Foreground="{DynamicResource Text2}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Pick Tethering on Home or in the tray to get back online." FontSize="13" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <CheckBox x:Name="DontAsk" Content="Don't ask again" Margin="0,16,0,0" FontSize="13" FontWeight="SemiBold"
                          Foreground="{DynamicResource Text2}" VerticalContentAlignment="Center"/>
            </StackPanel>
            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="24,18">
                <UniformGrid Columns="2">
                    <Button x:Name="Confirm" Style="{StaticResource Primary}" Margin="0,0,5,0" Click="Confirm_Click" IsDefault="True"/>
                    <Button Style="{StaticResource Secondary}" Content="Cancel" Margin="5,0,0,0" Click="Cancel_Click" IsCancel="True"/>
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</Window>
