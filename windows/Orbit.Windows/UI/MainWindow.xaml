<Window x:Class="Orbit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Orbit.UI"
        Title="Orbit" Width="1180" Height="800" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Manrope}" Foreground="{DynamicResource Text}"
        Background="{DynamicResource Bg}" AllowDrop="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <ui:Logo DockPanel.Dock="Left" Margin="16,0,10,0" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Text="Orbit" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Chrome}" Click="Min_Click" AutomationProperties.Name="Minimize">
                    <Path Data="M0 5h10" Stroke="{DynamicResource Text}" StrokeThickness="1" Width="10" Height="10"/>
                </Button>
                <Button Style="{StaticResource Chrome}" Click="Max_Click" AutomationProperties.Name="Maximize">
                    <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Stroke="{DynamicResource Text}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource Chrome}" Click="Close_Click" AutomationProperties.Name="Close">
                    <Path Data="M0 0l10 10M10 0 0 10" Stroke="{DynamicResource Text}" StrokeThickness="1" Width="10" Height="10"/>
                </Button>
            </StackPanel>
            <Border x:Name="StatusPill" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="10,4" CornerRadius="999"
                    VerticalAlignment="Center" Background="{DynamicResource GreenSoft}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Green}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GreenInk}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailCol" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rail -->
            <DockPanel x:Name="Rail" Grid.Column="0" Margin="8,8,8,16">
                <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource Nav}" GroupName="nav" Tag="settings" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcSettings}" Margin="0,0,14,0"/><TextBlock Text="Settings"/></StackPanel>
                </RadioButton>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="nav" Tag="home" Checked="Nav_Checked" IsChecked="True">
                        <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcHome}" Margin="0,0,14,0"/><TextBlock Text="Home"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavClipboard" Style="{StaticResource Nav}" GroupName="nav" Tag="clipboard" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcClip}" Margin="0,0,14,0"/><TextBlock Text="Clipboard"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNotifications" Style="{StaticResource Nav}" GroupName="nav" Tag="notifications" Checked="Nav_Checked">
                        <Grid>
                            <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcBell}" Margin="0,0,14,0"/><TextBlock Text="Notifications"/></StackPanel>
                            <Border x:Name="Badge" HorizontalAlignment="Right" MinWidth="20" Height="20" CornerRadius="10" Padding="5,0"
                                    Background="{DynamicResource Accent}">
                                <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavFiles" Style="{StaticResource Nav}" GroupName="nav" Tag="files" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcFolder}" Margin="0,0,14,0"/><TextBlock Text="Files"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBuds" Style="{StaticResource Nav}" GroupName="nav" Tag="buds" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcBuds}" Margin="0,0,14,0"/><TextBlock Text="Buds"/></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- Content layer -->
            <Border x:Name="Layer" Grid.Column="1" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource LayerBorder}"
                    BorderThickness="1,1,0,0" CornerRadius="12,0,0,0">
                <ContentControl x:Name="Host" Focusable="False"/>
            </Border>

            <!-- Drag-and-drop overlay -->
            <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#CC4B4FE6" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:Ic Data="{StaticResource IcUpload}" Width="48" Height="48" Foreground="White" Thickness="1.6"/>
                    <TextBlock x:Name="DropText" Foreground="White" FontSize="22" FontWeight="ExtraBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
