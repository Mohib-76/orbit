<Window x:Class="Orbit.UI.MirrorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Orbit.UI"
        Title="Orbit · Set up screen mirroring" Width="1120" Height="780" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Manrope}" Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <ui:Logo DockPanel.Dock="Left" Margin="16,0,10,0" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Text="Orbit · Set up screen mirroring" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Chrome}" Click="Min_Click" AutomationProperties.Name="Minimize">
                    <Path Data="M0 5h10" Stroke="{DynamicResource Text}" StrokeThickness="1" Width="10" Height="10"/>
                </Button>
                <Button Style="{StaticResource Chrome}" Click="Close_Click" AutomationProperties.Name="Close">
                    <Path Data="M0 0l10 10M10 0 0 10" Stroke="{DynamicResource Text}" StrokeThickness="1" Width="10" Height="10"/>
                </Button>
            </StackPanel>
            <Border x:Name="PhonePill" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="10,4" CornerRadius="999" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PhoneDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PhoneText" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Layout" MaxWidth="1080" Margin="24" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="GapCol" Width="48"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Steps -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ONE-TIME SETUP · ABOUT 30 SECONDS" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource SoftInk}"/>
                    <TextBlock Text="See and control your phone from this PC." FontSize="38" FontWeight="ExtraBold" LineHeight="42"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="15" Margin="0,10,0,0" LineHeight="22" TextWrapping="Wrap"
                               Text="Mirroring uses Android's wireless debugging. Orbit walks your phone through it, so you won't have to dig through settings."/>
                    <StackPanel x:Name="Steps" Margin="0,22,0,0"/>

                    <Border x:Name="WifiWarn" CornerRadius="12" Padding="16,12" Margin="0,10,0,0" Background="{DynamicResource AmberSoft}" Visibility="Collapsed">
                        <DockPanel>
                            <ui:Ic Data="{StaticResource IcWifi}" Width="18" Height="18" Foreground="{DynamicResource AmberInk}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="WifiText" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="16,8" Margin="0,10,0,0" Background="{DynamicResource Surface2}">
                        <DockPanel>
                            <ui:Ic Data="{StaticResource IcUsb}" Width="18" Height="18" Foreground="{DynamicResource Text2}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Use USB" Click="UseUsb_Click" Height="32"/>
                            <TextBlock x:Name="UsbText" FontSize="13" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Prefer a cable? Plug in USB and allow debugging on the phone."/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- QR -->
                <StackPanel x:Name="QrColumn" Grid.Column="2" VerticalAlignment="Center" Width="320">
                    <Border Style="{StaticResource CardBox}" Padding="28" HorizontalAlignment="Center">
                        <StackPanel>
                            <Border Background="White" CornerRadius="6" Padding="6">
                                <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       AutomationProperties.Name="Wireless debugging pairing code"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Grid Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource Soft}" StrokeThickness="1.5"/>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}"/>
                                    <Canvas Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform><RotateTransform x:Name="Spin"/></Canvas.RenderTransform>
                                        <Ellipse Canvas.Left="6" Canvas.Top="-2" Width="4" Height="4" Fill="{DynamicResource Accent}"/>
                                        <Canvas.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Canvas.Triggers>
                                    </Canvas>
                                </Grid>
                                <TextBlock x:Name="StatusText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" MaxWidth="300" LineHeight="18">
                        After this, mirroring starts in one click from Home, the tray, or <Run FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Text}">Ctrl Alt M</Run>.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
