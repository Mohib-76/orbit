<Window x:Class="Orbit.UI.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Orbit.UI"
        Width="360" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" AllowDrop="True"
        FontFamily="{StaticResource Manrope}" Foreground="{DynamicResource Text}">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Margin="16,16,16,14">
                <!-- Device -->
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Soft}" Margin="0,0,12,0">
                        <ui:Ic Data="{StaticResource IcPhone}" Width="22" Height="22" Foreground="{DynamicResource SoftInk}"/>
                    </Border>
                    <Grid DockPanel.Dock="Right" Width="52" Height="52">
                        <ui:Ring Value="{Binding Phone.BatteryFraction}" StrokeWidth="5" Track="{DynamicResource Track}" Fill="{DynamicResource Green}"/>
                        <TextBlock x:Name="BatteryNum" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LinkText" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Ic Data="{StaticResource IcBolt}" Width="12" Height="12" Thickness="0" IconFill="{DynamicResource GreenInk}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Phone.ChargeText}" Style="{StaticResource Caption}"/>
                </StackPanel>

                <!-- USB mode (only while a cable is in) -->
                <StackPanel x:Name="UsbBox" Margin="0,12,0,0" Visibility="Collapsed">
                    <ContentControl x:Name="UsbSwitchHost" Focusable="False"/>
                    <DockPanel Margin="0,6,0,0" MinHeight="24">
                        <Button x:Name="UsbOpen" DockPanel.Dock="Right" Style="{StaticResource Primary}" Height="24" Padding="8,0" FontSize="11"
                                Content="Open in Explorer" Click="UsbOpen_Click" Visibility="Collapsed"/>
                        <Button x:Name="UsbLink" DockPanel.Dock="Right" Style="{StaticResource Link}" Height="24" FontSize="11" Click="UsbLink_Click"/>
                        <ui:Ic x:Name="UsbIcon" Data="{StaticResource IcCable}" Width="12" Height="12" Thickness="2.2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UsbText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>

                <!-- Quick actions -->
                <UniformGrid Columns="5" Margin="-3,14,-3,0">
                    <UniformGrid.Resources>
                        <Style x:Key="Quick" TargetType="Button" BasedOn="{StaticResource Secondary}">
                            <Setter Property="Height" Value="64"/>
                            <Setter Property="Margin" Value="3,0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </UniformGrid.Resources>
                    <Button Style="{StaticResource Quick}" Click="Mirror_Click" ToolTip="Ctrl Alt M">
                        <StackPanel><ui:Ic Data="{StaticResource IcMirror}" HorizontalAlignment="Center"/><TextBlock Text="Mirror" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Quick}" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Click="Clip_Click">
                        <StackPanel><ui:Ic Data="{StaticResource IcClip}" HorizontalAlignment="Center"/><TextBlock Text="Clipboard" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Quick}" Click="File_Click">
                        <StackPanel><ui:Ic Data="{StaticResource IcUpload}" HorizontalAlignment="Center"/><TextBlock Text="Send file" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Quick}" Click="Pause_Click">
                        <StackPanel><ui:Ic Data="{StaticResource IcMoon}" HorizontalAlignment="Center"/><TextBlock x:Name="PauseText" Text="Pause" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Quick}" Click="Settings_Click">
                        <StackPanel><ui:Ic Data="{StaticResource IcSettings}" HorizontalAlignment="Center"/><TextBlock Text="Settings" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Listening: the phone's player and the buds -->
                <Border x:Name="BudsCard" Margin="0,12,0,0" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource BtnBg}">
                    <StackPanel>
                        <StackPanel x:Name="MediaRow" Visibility="Collapsed">
                            <DockPanel Margin="10,10,10,8">
                                <Border Width="40" Height="40" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                                    <Grid>
                                        <Border x:Name="MArtNone" CornerRadius="6">
                                            <TextBlock x:Name="MArtInitial" Foreground="White" FontSize="15" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="MArtBox" CornerRadius="6">
                                            <Border.Background><ImageBrush x:Name="MArt" Stretch="UniformToFill"/></Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Button x:Name="MNext" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="32" Click="MediaNext_Click" AutomationProperties.Name="Next">
                                    <ui:Ic x:Name="MNextIcon" Data="{StaticResource IcNext}" Width="14" Height="14" Thickness="0" IconFill="{DynamicResource Text}"/>
                                </Button>
                                <Button x:Name="MPlay" DockPanel.Dock="Right" Style="{StaticResource PlayBtn}" Width="32" Height="32" Margin="2,0" Click="MediaPlay_Click" AutomationProperties.Name="Play or pause">
                                    <ui:Ic x:Name="MPlayIcon" Data="{StaticResource IcPause}" Width="14" Height="14" Thickness="0" IconFill="{DynamicResource OnAccent}"/>
                                </Button>
                                <Button x:Name="MPrev" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="32" Margin="6,0,0,0" Click="MediaPrev_Click" AutomationProperties.Name="Previous">
                                    <ui:Ic x:Name="MPrevIcon" Data="{StaticResource IcPrev}" Width="14" Height="14" Thickness="0" IconFill="{DynamicResource Text}"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run x:Name="MTitle" FontWeight="ExtraBold"/><Run x:Name="MArtist" Foreground="{DynamicResource Text2}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="MAppChip" Width="12" Height="12" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="MAppInitial" Foreground="White" FontSize="7" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="MWhere" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="10,0,10,8">
                                <TextBlock x:Name="MPos" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="MLen" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ui:SeekBar x:Name="MBar" Height="16" BarHeight="4" Track="{DynamicResource Track}" Ring="{DynamicResource BtnBg}"
                                            AutomationProperties.Name="Seek"/>
                            </DockPanel>
                        </StackPanel>
                        <Border x:Name="BudsPart" Padding="10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0">
                            <StackPanel>
                                <DockPanel>
                                    <ui:Ic Data="{StaticResource IcBuds}" Foreground="{DynamicResource SoftInk}" Width="16" Height="16" Margin="0,0,10,0"/>
                                    <Button x:Name="BudsPlayHere" DockPanel.Dock="Right" Style="{StaticResource Link}" Height="24" FontSize="11"
                                            Background="{DynamicResource Soft}" Content="Play here" Click="BudsPlayHere_Click"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run x:Name="BudsName" FontWeight="ExtraBold"/><Run x:Name="BudsInfo" Foreground="{DynamicResource Text2}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </DockPanel>
                                <Border x:Name="BudsModesBox" Background="{DynamicResource Surface2}" CornerRadius="7" Padding="1" Margin="0,8,0,0">
                                    <UniformGrid x:Name="BudsModes" Columns="3"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Notifications -->
            <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="8,10,8,6">
                <StackPanel>
                    <DockPanel Margin="8,0,8,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Clear all" FontSize="12" Click="ClearAll_Click"/>
                        <TextBlock Text="Notifications" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="NoNotifs" Text="You're all caught up." Style="{StaticResource Caption}" Margin="8,4,8,10"/>
                    <ItemsControl x:Name="Notifs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8,4">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{Binding Tint}" Margin="0,0,10,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                        </Grid>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="28" Tag="{Binding Key}" Click="Dismiss_Click" AutomationProperties.Name="Dismiss">
                                        <ui:Ic Data="{StaticResource IcClose}" Width="12" Height="12" Thickness="2"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding TitleLine, Mode=OneWay}"/><Run Text=" · " Foreground="{DynamicResource Text2}"/><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource Text2}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TextLine}" FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="8,8,8,2">
                        <ui:Logo Width="16" Height="16" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Open Orbit ›" FontSize="12" Click="Open_Click"/>
                        <TextBlock Text="orbit" FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
