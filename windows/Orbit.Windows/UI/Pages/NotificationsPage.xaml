<UserControl x:Class="Orbit.UI.Pages.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Orbit.UI">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseBtn" Style="{StaticResource Secondary}" Click="Pause_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcMoon}" Width="16" Height="16" Thickness="2" Margin="0,0,8,0"/><TextBlock x:Name="PauseText"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Secondary}" Content="Clear all" Click="Clear_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding DoNotDisturbText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border x:Name="Empty" Style="{StaticResource CardBox}" Margin="0,24,0,0" Padding="40">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconChip}" Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Center">
                        <ui:Ic Data="{StaticResource IcCheck}" Width="24" Height="24"/>
                    </Border>
                    <TextBlock Text="No notifications. You're all caught up." Style="{StaticResource CardTitle}" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Notifications from your phone show up here and as Windows toasts. Choose which apps mirror in Orbit on your phone." Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="420"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="List" ItemsSource="{Binding Notifications}" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBox}" Padding="16" Margin="0,0,0,10">
                            <DockPanel>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{Binding Tint}" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="36" Height="36"/>
                                    </Grid>
                                </Border>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="Dismiss_Click" Tag="{Binding Key}"
                                        ToolTip="Dismiss on phone" AutomationProperties.Name="Dismiss" VerticalAlignment="Top">
                                    <ui:Ic Data="{StaticResource IcClose}" Width="14" Height="14" Thickness="2"/>
                                </Button>
                                <StackPanel>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2}">
                                        <Run Text="{Binding App, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TimeText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" FontWeight="Normal" Foreground="{DynamicResource Text2}" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
