<UserControl x:Class="Orbit.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Orbit.UI">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,32">

            <!-- Hero -->
            <Border Style="{StaticResource CardBox}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- USB mode (only while a cable is in) -->
                    <Border x:Name="UsbStrip" Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
                            Margin="0,20,0,0" Padding="0,16,0,0" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,16,4">
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Soft}" Margin="0,0,10,0">
                                    <ui:Ic Data="{StaticResource IcCable}" Width="16" Height="16" Thickness="2" Foreground="{DynamicResource SoftInk}"/>
                                </Border>
                                <TextBlock Text="Connected by USB" FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ContentControl x:Name="UsbSwitchHost" Width="340" Margin="0,4,16,4" VerticalAlignment="Center" Focusable="False"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                                <ui:Ic x:Name="UsbStatusIcon" Data="{StaticResource IcWifi}" Width="16" Height="16" Thickness="2" Margin="0,0,6,0"/>
                                <TextBlock x:Name="UsbStatusText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="UsbLink" Style="{StaticResource Link}" Margin="8,0,0,0" Click="UsbLink_Click"/>
                                <Button x:Name="UsbOpenFiles" Style="{StaticResource Primary}" Height="36" Padding="14,0" FontSize="13" Margin="12,0,0,0"
                                        Click="OpenPhoneFiles_Click" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcFolder}" Width="16" Height="16" Thickness="2" Margin="0,0,8,0"/><TextBlock Text="Open in File Explorer"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Width="78" Height="150" CornerRadius="18" Background="{DynamicResource PhoneBody}" Padding="5" Margin="0,0,28,0">
                        <Border CornerRadius="14" Background="{DynamicResource PhoneScreen}">
                            <Viewbox Width="34" Height="34">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="16" Canvas.Top="16" Width="16" Height="16" Fill="White"/>
                                    <Path Data="M28.4 7.58A17 17 0 1 0 40.42 19.6" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="31.82" Canvas.Top="7.78" Width="8.4" Height="8.4" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateText" Text="{Binding Phone.StatusText}" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Phone.Name}" FontSize="34" FontWeight="ExtraBold" Margin="0,10,0,10" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel TextElement.Foreground="{DynamicResource Text2}" TextElement.FontSize="13" TextElement.FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <ui:Ic x:Name="LinkIcon" Data="{StaticResource IcUsb}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LinkText" Text="{Binding Phone.Link}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <ui:Ic Data="{StaticResource IcLock}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Encrypted"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <ui:Ic Data="{StaticResource IcShield}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="No cloud"/>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource Primary}" Click="SendClipboard_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcClip}" Width="16" Height="16" Thickness="2" Margin="0,0,8,0"/><TextBlock Text="Send clipboard"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Secondary}" Click="SendFiles_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcUpload}" Width="16" Height="16" Thickness="2" Margin="0,0,8,0"/><TextBlock Text="Send files"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Secondary}" Click="Mirror_Click" Margin="0,0,8,8" ToolTip="Ctrl Alt M">
                                <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcMirror}" Width="16" Height="16" Thickness="2" Margin="0,0,8,0"/><TextBlock Text="Mirror screen"/></StackPanel>
                            </Button>
                            <Button x:Name="PauseBtn" Style="{StaticResource Secondary}" Click="Pause_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcMoon}" Width="16" Height="16" Thickness="2" Margin="0,0,8,0"/><TextBlock x:Name="PauseText" Text="Pause 1 h"/></StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Grid Width="128" Height="128">
                            <ui:Ring Value="{Binding Phone.BatteryFraction}" StrokeWidth="10" Track="{DynamicResource Track}" Fill="{DynamicResource Green}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Phone.BatteryText}" FontSize="30" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding Phone.Charging, Converter={StaticResource BoolVis}}">
                                    <ui:Ic Data="{StaticResource IcBolt}" Width="12" Height="12" Thickness="0" IconFill="{DynamicResource GreenInk}"/>
                                    <TextBlock Text="Charging" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GreenInk}" Margin="3,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Phone.ChargeText}" Width="96" Margin="18,0,0,0" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Playing on your phone -->
            <Border x:Name="MediaCard" Style="{StaticResource CardBox}" Padding="18" Margin="0,20,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Grid Width="96" Height="96" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Border x:Name="ArtBox" CornerRadius="12" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="NoArtBox" CornerRadius="12" Background="{DynamicResource Soft}">
                            <Border x:Name="NoArtChip" Width="44" Height="44" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="NoArtInitial" Foreground="White" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="NoArtIcon"/>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <Border x:Name="PlayerTabs" DockPanel.Dock="Right" Background="{DynamicResource Chip}" CornerRadius="9" Padding="1.5" Visibility="Collapsed">
                                <StackPanel x:Name="PlayerTabsPanel" Orientation="Horizontal"/>
                            </Border>
                            <TextBlock Text="PLAYING ON YOUR PHONE" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                            <Border x:Name="AppChip" Width="16" Height="16" CornerRadius="4" Margin="10,0,6,0" VerticalAlignment="Center" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="AppChipInitial" Foreground="White" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="AppChipIcon"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AppName" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <TextBlock x:Name="TrackTitle" FontSize="18" FontWeight="ExtraBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackSub" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"/>
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Button x:Name="PrevBtn" Style="{StaticResource MediaBtn}" Click="Prev_Click" AutomationProperties.Name="Previous">
                                    <ui:Ic x:Name="PrevIcon" Data="{StaticResource IcPrev}" Width="16" Height="16" Thickness="0" IconFill="{DynamicResource Text}"/>
                                </Button>
                                <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Margin="4,0" Click="Play_Click" AutomationProperties.Name="Play or pause">
                                    <ui:Ic x:Name="PlayIcon" Data="{StaticResource IcPause}" Width="18" Height="18" Thickness="0" IconFill="{DynamicResource OnAccent}"/>
                                </Button>
                                <Button x:Name="NextBtn" Style="{StaticResource MediaBtn}" Click="Next_Click" AutomationProperties.Name="Next">
                                    <ui:Ic x:Name="NextIcon" Data="{StaticResource IcNext}" Width="16" Height="16" Thickness="0" IconFill="{DynamicResource Text}"/>
                                </Button>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Width="120"/>
                            <TextBlock x:Name="PosText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <StackPanel x:Name="LiveBadge" Orientation="Horizontal" Visibility="Collapsed">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource LiveRed}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource LiveRed}"/>
                                </StackPanel>
                                <TextBlock x:Name="LenText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                            </StackPanel>
                            <ui:SeekBar x:Name="Seek" Height="20" VerticalAlignment="Center" Track="{DynamicResource Track}" Ring="{DynamicResource Card}"
                                        AutomationProperties.Name="Seek"/>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Feature cards -->
            <UniformGrid x:Name="Cards" Columns="3" Margin="-10,10,-10,0">

                <!-- Clipboard -->
                <Border Style="{StaticResource CardBox}" Margin="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Border Style="{StaticResource IconChip}" Margin="0,0,10,0"><ui:Ic Data="{StaticResource IcClip}"/></Border>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ClipboardAutoSync}"
                                      Click="SaveSettings" AutomationProperties.Name="Clipboard auto-sync"/>
                            <TextBlock DockPanel.Dock="Right" Text="Auto-sync" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Clipboard" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,14,0,0">
                            Copy on either device and paste on the other.
                            <Run FontFamily="{StaticResource Mono}" FontSize="11">Ctrl Alt C</Run> sends now.
                        </TextBlock>
                        <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="14" MinHeight="86">
                            <StackPanel>
                                <TextBlock x:Name="ClipText" Style="{StaticResource Body}" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ui:Ic Data="{StaticResource IcCheck}" Width="14" Height="14" Foreground="{DynamicResource Text2}" Thickness="2" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ClipMeta" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource CardBox}" Margin="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Border Style="{StaticResource IconChip}" Margin="0,0,10,0"><ui:Ic Data="{StaticResource IcBell}"/></Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Click="OpenNotifications_Click">
                                <TextBlock x:Name="NotifCount"/>
                            </Button>
                            <TextBlock Text="Notifications" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <Grid>
                            <TextBlock x:Name="NotifEmpty" Text="No notifications. You're all caught up." Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ItemsControl x:Name="NotifList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,6">
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{Binding Tint}" Margin="0,0,10,0" VerticalAlignment="Top" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding TitleLine, Mode=OneWay}"/><Run Text=" · " Foreground="{DynamicResource Text2}"/><Run Text="{Binding App, Mode=OneWay}" Foreground="{DynamicResource Text2}" FontWeight="SemiBold"/><Run Text=" · " Foreground="{DynamicResource Text2}"/><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource Text2}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding TextLine}" FontSize="13" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Files -->
                <Border Style="{StaticResource CardBox}" Margin="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Border Style="{StaticResource IconChip}" Margin="0,0,10,0"><ui:Ic Data="{StaticResource IcFolder}"/></Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="All transfers" Click="OpenFiles_Click"/>
                            <TextBlock Text="Files" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <StackPanel x:Name="LatestTransfer" DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock x:Name="LtDetail" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="LtName" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ProgressBar x:Name="LtProgress" Style="{StaticResource Progress}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border x:Name="DropZone" MinHeight="96" CornerRadius="12" Background="{DynamicResource DropBg}" Cursor="Hand"
                                MouseLeftButtonUp="DropZone_Click" AllowDrop="True">
                            <Border.BorderBrush>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Rectangle StrokeDashArray="4 3" Stroke="{DynamicResource DropBorder}" StrokeThickness="2" RadiusX="12" RadiusY="12"
                                                   Width="{Binding ActualWidth, ElementName=DropZone}" Height="{Binding ActualHeight, ElementName=DropZone}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>2</Border.BorderThickness>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:Ic Data="{StaticResource IcUpload}" Width="24" Height="24" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DropLabel" FontSize="13" FontWeight="Bold" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
