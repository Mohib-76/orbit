<UserControl x:Class="Orbit.UI.Pages.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Orbit.UI">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,32">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="Send_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><ui:Ic Data="{StaticResource IcUpload}" Width="16" Height="16" Thickness="2" Margin="0,0,8,0"/><TextBlock Text="Send clipboard to phone"/></StackPanel>
                </Button>
                <TextBlock Text="Clipboard" Style="{StaticResource H1}"/>
            </DockPanel>

            <Border Style="{StaticResource CardBox}" Margin="0,20,0,0" Padding="8">
                <StackPanel>
                    <DockPanel Margin="12,10">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ClipboardAutoSync}" Click="Save" AutomationProperties.Name="Auto-sync"/>
                        <StackPanel>
                            <TextBlock Text="Auto-sync" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Text you copy here appears on your phone's clipboard. Copy on the phone, then tap Send clipboard (Android only lets apps read the clipboard while you're using them)." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource Track}"/>
                    <DockPanel Margin="12,10">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ClipboardKeepHistory}" Click="Save" AutomationProperties.Name="Keep history"/>
                        <StackPanel>
                            <TextBlock Text="Keep history" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Last 10 items, kept in memory on this PC only" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,24,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Clear history" Click="Clear_Click"/>
                <TextBlock Text="Recent" Style="{StaticResource CardTitle}"/>
            </DockPanel>

            <TextBlock x:Name="Empty" Text="Nothing synced yet. Copy some text to try it." Style="{StaticResource Caption}" Margin="0,8"/>
            <ItemsControl ItemsSource="{Binding ClipHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBox}" Padding="16" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="Copy_Click" Tag="{Binding Text}"
                                        ToolTip="Copy again" AutomationProperties.Name="Copy" VerticalAlignment="Top">
                                    <ui:Ic Data="{StaticResource IcCopy}" Width="16" Height="16"/>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Body}" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                        <Run Text="{Binding Direction, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Time, Mode=OneWay, StringFormat=HH:mm}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
