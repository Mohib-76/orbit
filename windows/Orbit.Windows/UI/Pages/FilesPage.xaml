<UserControl x:Class="Orbit.UI.Pages.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Orbit.UI">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Secondary}" Content="Open folder" Click="OpenFolder_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Secondary}" Content="Clear finished" Click="ClearFinished_Click"/>
                </StackPanel>
                <TextBlock Text="Files" Style="{StaticResource H1}"/>
            </DockPanel>

            <Border x:Name="DropZone" Margin="0,20,0,0" MinHeight="170" CornerRadius="16" Background="{DynamicResource DropBg}"
                    AllowDrop="True" Cursor="Hand" MouseLeftButtonUp="Browse_Click" BorderThickness="2">
                <Border.BorderBrush>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Rectangle StrokeDashArray="4 3" Stroke="{DynamicResource DropBorder}" StrokeThickness="2" RadiusX="16" RadiusY="16"
                                       Width="{Binding ActualWidth, ElementName=DropZone}" Height="{Binding ActualHeight, ElementName=DropZone}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.BorderBrush>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:Ic Data="{StaticResource IcUpload}" Width="32" Height="32" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DropLabel" FontSize="16" FontWeight="ExtraBold" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center">
                        <Run Text="or click to browse · saved on the phone to Download/Orbit"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="Transfers" Style="{StaticResource CardTitle}" Margin="0,26,0,10"/>
            <TextBlock x:Name="Empty" Style="{StaticResource Caption}" Text="No transfers yet. Share a file to Orbit on your phone, or drop one here."/>

            <ItemsControl ItemsSource="{Binding Transfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBox}" Padding="14" Margin="0,0,0,10">
                            <DockPanel>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Soft}" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Ext}" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource SoftInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource Small}" Content="Accept" Click="Accept_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding NeedsAnswer, Converter={StaticResource BoolVis}}"/>
                                    <Button Style="{StaticResource Small}" Content="Open" Click="Open_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}"/>
                                    <Button Style="{StaticResource Small}" Content="Show in folder" Click="Show_Click" Tag="{Binding}"
                                            Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}"/>
                                    <Button Style="{StaticResource Small}" Content="Retry" Click="Retry_Click" Tag="{Binding}" Margin="0,0,6,0"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"/>
                                    <Button Style="{StaticResource IconBtn}" Click="Cancel_Click" Tag="{Binding}" ToolTip="Cancel" AutomationProperties.Name="Cancel"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                        <ui:Ic Data="{StaticResource IcClose}" Width="14" Height="14" Thickness="2"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Arrow}" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource Progress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,7,0,5"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
