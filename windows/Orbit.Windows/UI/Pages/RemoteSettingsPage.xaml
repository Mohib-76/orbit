<UserControl x:Class="Orbit.UI.Pages.RemoteSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Orbit.UI">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="12,10"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource CardBox}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Margin" Value="12,12,12,4"/>
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>
        <Style x:Key="RowIcon" TargetType="Border" BasedOn="{StaticResource IconChip}">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="22,28,22,32">
            <StackPanel Margin="10,0,10,10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Link}" Content="Settings" Padding="0" Height="20" FontWeight="Bold" Click="Back_Click"/>
                    <TextBlock Text=" › Phone remote" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Phone remote" Style="{StaticResource H1}" Margin="0,6,0,0"/>
                <TextBlock x:Name="Intro" Style="{StaticResource Caption}" FontSize="14" MaxWidth="640" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>

            <UniformGrid x:Name="Grid2" Columns="2">
                <!-- Allow from the phone -->
                <Border Style="{StaticResource Section}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Allow from the phone" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Border Style="{StaticResource RowIcon}"><ui:Ic Data="{StaticResource IcVolume}" Width="17" Height="17" Foreground="{DynamicResource SoftInk}"/></Border>
                            <CheckBox x:Name="VolumeToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed" AutomationProperties.Name="Volume"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Volume" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Set and mute this PC's volume" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Power buttons -->
                <Border Style="{StaticResource Section}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Power buttons" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Border Style="{StaticResource RowIcon}"><ui:Ic Data="{StaticResource IcLock}" Width="17" Height="17" Foreground="{DynamicResource SoftInk}"/></Border>
                            <CheckBox x:Name="LockToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed" AutomationProperties.Name="Lock"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lock" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Locks right away" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Rule}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Border Style="{StaticResource RowIcon}"><ui:Ic Data="{StaticResource IcMoon}" Width="17" Height="17" Foreground="{DynamicResource SoftInk}"/></Border>
                            <CheckBox x:Name="SleepToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed" AutomationProperties.Name="Sleep"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sleep" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Wakes with the keyboard or power button" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Rule}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Border Style="{StaticResource RowIcon}"><ui:Ic Data="{StaticResource IcPower}" Width="17" Height="17" Foreground="{DynamicResource SoftInk}"/></Border>
                            <CheckBox x:Name="ShutdownToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed" AutomationProperties.Name="Shut down"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Shut down" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Always asks on the phone first" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Rule}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <Border Style="{StaticResource RowIcon}"><ui:Ic Data="{StaticResource IcRotate}" Width="17" Height="17" Foreground="{DynamicResource SoftInk}"/></Border>
                            <CheckBox x:Name="RestartToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed" AutomationProperties.Name="Restart"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Restart" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Always asks on the phone first" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Links from the phone -->
            <Border Style="{StaticResource Section}" Padding="20,18">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Chip}" CornerRadius="10" Padding="1" Width="290" VerticalAlignment="Center" Margin="16,0,0,0">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="LinksOpen" Style="{StaticResource Segment}" GroupName="links" Height="32" FontSize="12" Content="Open right away"
                                         Checked="Links_Checked" AutomationProperties.Name="Open links right away"/>
                            <RadioButton x:Name="LinksAsk" Style="{StaticResource Segment}" GroupName="links" Height="32" FontSize="12" Content="Ask first"
                                         Checked="Links_Checked" AutomationProperties.Name="Ask before opening links"/>
                        </UniformGrid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Links from the phone" FontSize="15" FontWeight="ExtraBold"/>
                        <TextBlock x:Name="LinksLine" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Your commands -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <DockPanel Margin="12,12,12,6">
                        <Button x:Name="AddBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Height="36" Padding="14,0" FontSize="13" Click="Add_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:Ic Data="{StaticResource IcPlus}" Width="14" Height="14" Thickness="2.6" Foreground="{DynamicResource OnAccent}" Margin="0,0,6,0"/>
                                <TextBlock Text="Add command"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Your commands" FontSize="15" FontWeight="ExtraBold"/>
                            <TextBlock Text="Show up as buttons on the phone. They run on this PC as you." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="NoCommands" Style="{StaticResource Caption}" Margin="12,6,12,10"
                               Text="No commands yet. Add one to run a script, open your apps or anything else from the phone."/>
                    <ItemsControl x:Name="Commands">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Rule}"/>
                                    <DockPanel Margin="12,10" MinHeight="44">
                                        <Border Style="{StaticResource RowIcon}" Background="{DynamicResource Surface2}">
                                            <ui:Ic Data="{StaticResource IcTerminal}" Width="17" Height="17" Foreground="{DynamicResource Text2}"/>
                                        </Border>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="32" Height="32" Tag="{Binding}" Click="Remove_Click"
                                                AutomationProperties.Name="{Binding RemoveLabel}">
                                            <ui:Ic Data="{StaticResource IcTrash}" Width="16" Height="16" Thickness="2" Foreground="{DynamicResource Danger}"/>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Height="32" Content="Edit" Margin="12,0,4,0" Tag="{Binding}" Click="Edit_Click"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AskText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Command}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Text2}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add or edit -->
                    <Border x:Name="Form" Visibility="Collapsed" Margin="4" Padding="16" CornerRadius="12" Background="{DynamicResource DropBg}"
                            BorderBrush="{DynamicResource DropBorder}" BorderThickness="1.5">
                        <StackPanel>
                            <UniformGrid x:Name="FormGrid" Columns="2">
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="Button name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NameBox" Style="{StaticResource Field}" FontWeight="SemiBold" MaxLength="40"
                                             AutomationProperties.Name="Button name" TextChanged="Form_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="Command or script" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Height="38" Content="Browse" Margin="6,0,0,0" Click="Browse_Click"/>
                                        <TextBox x:Name="CommandBox" Style="{StaticResource Field}" FontFamily="{StaticResource Mono}" FontSize="13"
                                                 AutomationProperties.Name="Command or script" TextChanged="Form_Changed"/>
                                    </DockPanel>
                                </StackPanel>
                            </UniformGrid>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Small}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="SaveBtn" Style="{StaticResource Primary}" Height="34" Padding="16,0" FontSize="13" Content="Save" Click="SaveCommand_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="AskBox" Style="{StaticResource Switch}" AutomationProperties.Name="Ask on the phone before running"/>
                                    <TextBlock Text="Ask on the phone before running" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       Text="A program or script (.exe, .ps1, .bat…) runs, and any other file opens in its app. Anything else runs as a hidden command line."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="12,6,12,0">
                <ui:Ic Data="{StaticResource IcShield}" Width="16" Height="16" Thickness="2" Foreground="{DynamicResource SoftInk}" Margin="0,0,10,0"/>
                <TextBlock Text="Every remote action shows a notification on this PC, so you always know what ran." Style="{StaticResource Caption}" FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
