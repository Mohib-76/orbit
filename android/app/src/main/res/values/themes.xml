<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="orbit_primary">#4B4FE6</color>
    <color name="orbit_bg">#FCFBFF</color>

    <style name="Theme.Orbit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/orbit_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/orbit_primary</item>
    </style>

    <style name="Theme.Orbit.Translucent" parent="Theme.Orbit">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>

    <style name="Theme.Orbit.Invisible" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
